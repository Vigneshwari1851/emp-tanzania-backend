						],
						"url": {
							"raw": "{{base_url}}/roles/1/permissions/1",
							"host": ["{{base_url}}"],
							"path": ["roles", "1", "permissions", "1"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "token",
			"value": "your_jwt_token_here",
			"type": "string"
		}
	]
