		{
			"name": "Role-Permission Mapping",
			"item": [
				{
					"name": "Sync Role Permissions",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"permission_ids\": [1, 2, 3]\n}",
							"options": {
								"raw": { "language": "json" }
							}
						},
						"url": {
							"raw": "{{base_url}}/roles/1/permissions",
							"host": ["{{base_url}}"],
							"path": ["roles", "1", "permissions"]
