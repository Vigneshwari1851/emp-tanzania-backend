generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                     @id @default(autoincrement())
  username            String?
  email               String                  @unique
  password            String
  status              Boolean                 @default(true)
  is_deleted          Boolean                 @default(false)
  deleted_at          DateTime?
  created_at          DateTime                @default(now())
  updated_at          DateTime                @updatedAt
  last_login          DateTime?
  failed_login_attempts Int                   @default(0)
  lockout_until        DateTime?
  sessionToken        String?                 @map("session_token")
  activityLogs        ActivityLog[]
  announcements       announcements[]
  issuedAssignments   AssetAssignment[]       @relation("AssetIssuer")
  assetAssignments    AssetAssignment[]       @relation("UserAssetAssignments")
  assetHistoryChanges AssetHistory[]          @relation("AssetHistoryModifier")
  assetApprovals      AssetRequest[]          @relation("AssetApprover")
  assetRequests       AssetRequest[]          @relation("UserAssetRequests")
  attendance          Attendance[]
  bgvCasesReviewed    BgvCase[]               @relation("BgvReviewer")
  bgvReviews          BgvReview[]
  company_news        company_news[]
  department          department[]
  uploadedDocuments   Document[]              @relation("DocumentUploader")
  ownerDocuments      Document[]              @relation("DocumentOwner")
  managedExitRequests ExitRequest[]           @relation("ManagerExitRequests")
  exitRequests        ExitRequest[]           @relation("UserExitRequests")
  ktAssigneeExitRequests ExitRequest[]        @relation("KTAssigneeExitRequests")
  ktVerifiedByExitRequests ExitRequest[]      @relation("KTVerifiedByExitRequests")
  exitWorkflowActions ExitWorkflowHistory[]
  expenseClaims       ExpenseClaim[]
  interviews          InterviewInterviewer[]
  leaveBalances       LeaveBalance[]
  approvedLeaves      LeaveRequest[]          @relation("LeaveApprover")
  managedLeaves       LeaveRequest[]          @relation("ReportingManagerLeave")
  leaveRequests       LeaveRequest[]          @relation("UserLeaveRequests")
  lmsAssignments      LmsAssignment[]
  lmsCertificates     LmsCertificate[]
  lmsCourses          LmsCourse[]             @relation("CourseInstructor")
  lmsProgress         LmsProgress[]
  lmsQuizAttempts     LmsQuizAttempt[]
  notifications       Notification[]
  createdVersions     OfferVersion[]
  reviewerOffers      Offer[]                 @relation("ReviewerOffers")
  recruiterOffers     Offer[]                 @relation("RecruiterOffers")
  payslips            Payslip[]
  priorEmployments    PriorEmploymentIncome[]
  feedback            Feedback[]
  surveyResponses     SurveyResponse[]
  surveysCreated      Survey[]
  taxDeclarations     TaxDeclaration[]
  team                team[]
  managed_by          UserDetail[]            @relation("ReportingManager")
  details             UserDetail?
  employeeChangeRequests EmployeeChangeRequest[]
  roles               UserRole[]
  loanManagerApprovals   Loan[]               @relation("LoanReportingManager")
  loanHRApprovals        Loan[]               @relation("LoanHRApprover")
  loanFinanceApprovals   Loan[]               @relation("LoanFinanceApprover")
  advanceManagerApprovals Advance[]           @relation("AdvanceReportingManager")
  advanceHRApprovals      Advance[]           @relation("AdvanceHRApprover")
  advanceFinanceApprovals Advance[]           @relation("AdvanceFinanceApprover")
  loanApprovals          LoanApproval[]
  loginSessions          LoginSession[]

  @@map("users")
}

model LoginSession {
  id             Int      @id @default(autoincrement())
  user_id        Int
  token          String   @unique
  ip_address     String?
  user_agent     String?
  is_active      Boolean  @default(true)
  expires_at     DateTime
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  last_active_at DateTime?

  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "login_sessions_user_id_idx")
  @@index([is_active], map: "login_sessions_is_active_idx")
  @@map("login_sessions")
}

model UserDetail {
  id                     Int           @id @default(autoincrement())
  user_id                Int           @unique
  first_name             String?
  middle_name            String?
  last_name              String?
  date_of_birth          DateTime?
  gender                 String?
  nationality            String?
  marital_status         String?
  blood_group            String?
  phone                  String?
  secondary_phone        String?
  secondary_email        String?
  address                String?       @db.Text
  city                   String?
  state                  String?
  zip                    String?
  country                String?
  secondary_address      String?       @db.Text
  secondary_city         String?
  secondary_state        String?
  secondary_zip          String?
  secondary_country      String?
  emergency_contact      String?
  emergency_relationship String?
  emergency_phone        String?
  emergency_email        String?
  employee_id            String?       @unique
  department_id          Int?
  role_id                Int?
  employment_type        String?
  start_date             DateTime?
  work_location          String?
  work_schedule          String?
  reporting_manager_id   Int?
  probation_period       Int?
  base_salary            Decimal?      @db.Decimal(15, 2)
  currency               String?       @default("USD")
  salary_frequency       String?
  compensation_breakdown Json?
  family_members         Json?
  education              Json?
  employment_history     Json?
  passport_number        String?
  passport_expiry_date   DateTime?
  driving_license_number String?
  license_expiry_date    DateTime?
  pan_number             String?
  aadhaar_number         String?
  bank_name              String?
  branch_name            String?
  account_holder_name    String?
  account_number         String?
  ifsc_code              String?
  skills                 Json?
  certifications         Json?
  languages              Json?
  profile_picture        String?
  resume                 String?
  certificate_files      Json?
  documents              Json?
  passport_doc           String?
  dl_doc                 String?
  pan_doc                String?
  aadhaar_doc            String?
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt
  designation_id         Int?
  esi_number             String?
  exit_date              DateTime?
  is_draft               Boolean       @default(false)
  is_nri                 Boolean       @default(false)
  is_senior_citizen      Boolean       @default(false)
  joining_date           DateTime?
  payroll_group_id       Int?
  pf_uan                 String?
  shift_id               String?
  tax_regime             String?       @default("New")
  tax_regime_changed_at  DateTime?
  team_id                Int?
  user_type_id           Int?
  verification_statuses  Json?
  absence_status         String?
  sub_status             String?
  advances               Advance[]
  loans                  Loan[]
  loanApplications       LoanApplication[]
  department             department?   @relation(fields: [department_id], references: [id])
  designation            Designation?  @relation(fields: [designation_id], references: [id], map: "user_details_designation_id_fkey")
  payroll_group          PayrollGroup? @relation(fields: [payroll_group_id], references: [id])
  reporting_manager      User?         @relation("ReportingManager", fields: [reporting_manager_id], references: [id])
  role                   Role?         @relation(fields: [role_id], references: [id])
  team                   team?         @relation(fields: [team_id], references: [id])
  user                           User          @relation(fields: [user_id], references: [id])
  user_types                     user_types?   @relation(fields: [user_type_id], references: [id])
  secondary_reporting_to         Designation[] @relation("SecondaryReportingEmployee")

  @@index([department_id], map: "user_details_department_id_fkey")
  @@index([payroll_group_id], map: "user_details_payroll_group_id_fkey")
  @@index([reporting_manager_id], map: "user_details_reporting_manager_id_fkey")
  @@index([role_id], map: "user_details_role_id_fkey")
  @@index([team_id], map: "user_details_team_id_fkey")
  @@index([designation_id], map: "user_details_designation_id_fkey")
  @@index([user_type_id], map: "user_details_user_type_id_fkey")
  @@map("user_details")
}

model EmployeeChangeRequest {
  id                   Int        @id @default(autoincrement())
  user_id              Int
  requested_changes    Json
  category             String?
  status               String     @default("PENDING_MANAGER")
  manager_id           Int?
  manager_status       String?
  manager_note         String?    @db.Text
  manager_actioned_at  DateTime?
  hr_id                Int?
  hr_status            String?
  hr_note              String?    @db.Text
  hr_actioned_at       DateTime?
  applied_at           DateTime?
  created_at           DateTime   @default(now())
  updated_at           DateTime   @updatedAt

  user                 User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "employee_change_requests_user_id_idx")
  @@index([status], map: "employee_change_requests_status_idx")
  @@index([manager_id], map: "employee_change_requests_manager_id_idx")
  @@map("employee_change_requests")
}

model Bank {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("banks")
}

model Role {
  id                 Int                 @id @default(autoincrement())
  role_name          String
  description        String?             @db.Text
  status             Boolean             @default(true)
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  organization_id    Int?
  reimbursementTypes ReimbursementType[]
  loanTypes          LoanType[]
  permissions        RolePermission[]
  organizations      Organization?       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  userDetails        UserDetail[]
  users              UserRole[]

  @@unique([organization_id, role_name])
  @@index([organization_id])
  @@map("roles")
}

model Module {
  id          String       @id
  label       String
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  permissions Permission[]

  @@map("modules")
}

model Permission {
  id                    Int                     @id @default(autoincrement())
  permission_name       String
  key_name              String?                 @unique
  description           String?                 @db.Text
  created_at            DateTime                @default(now())
  updated_at            DateTime                @updatedAt
  moduleId              String?
  module                Module?                 @relation(fields: [moduleId], references: [id])
  roles                 RolePermission[]
  user_type_permissions user_type_permissions[]

  @@index([moduleId], map: "permissions_moduleId_fkey")
  @@map("permissions")
}

model UserRole {
  id          Int      @id @default(autoincrement())
  user_id     Int
  role_id     Int
  assigned_at DateTime @default(now())
  assigned_by Int?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  role        Role     @relation(fields: [role_id], references: [id])
  user        User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, role_id])
  @@index([role_id], map: "user_roles_role_id_fkey")
  @@map("user_roles")
}

model RolePermission {
  id            Int             @id @default(autoincrement())
  role_id       Int
  permission_id Int
  scope         PermissionScope @default(GLOBAL)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  permission    Permission      @relation(fields: [permission_id], references: [id])
  role          Role            @relation(fields: [role_id], references: [id])

  @@unique([role_id, permission_id])
  @@index([permission_id], map: "role_permissions_permission_id_fkey")
  @@map("role_permissions")
}

model OtpVerification {
  id         Int      @id @default(autoincrement())
  email      String
  otp        String
  expires_at DateTime
  verified   Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email])
  @@map("otp_verification")
}

model PasswordResetToken {
  id         Int      @id @default(autoincrement())
  email      String
  token      String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

model Organization {
  id                              Int                      @id @default(autoincrement())
  user_id                         Int?
  entity_name                     String
  company_code                    String?
  company_type                    String?
  slug                            String?                  @unique
  jurisdiction                    String?
  currency                        String
  fiscal_year_end                 String?
  pan                             String?
  tin                             String?
  sin                             String?
  ein                             String?
  siret                           String?
  other_tax_id                    String?
  address                         String                   @db.Text
  city                            String
  state                           String
  country                         String
  zip                             String
  business_unit                   String?
  cost_center                     String?
  job_architecture                Boolean                  @default(false)
  payroll_statutory_unit          String?
  legal_employer                  String?
  legislative_data_group          String?
  pay_frequency                   String?
  standard_working_hours_per_week Float
  working_days                    Json
  public_holidays                 Json
  logo_url                        String?                  @db.LongText
  is_deleted                      Boolean                  @default(false)
  deleted_at                      DateTime?
  created_at                      DateTime                 @default(now())
  updated_at                      DateTime                 @updatedAt
  fixed_break_time                Int?                     @default(60)
  fixed_end_time                  String?
  fixed_start_time                String?
  flex_core_end_time              String?                  @default("16:00")
  flex_core_start_time            String?                  @default("11:00")
  flex_max_hours                  Int?                     @default(12)
  flex_max_login_time             String?                  @default("11:00")
  flex_min_login_time             String?                  @default("07:00")
  flex_required_hours             Int?                     @default(8)
  schedule_type                   String?                  @default("fixed")
  enable_shifts                   Boolean                  @default(false)
  shifts                          Json?
  assetAssignments                AssetAssignment[]
  assetCategories                 AssetCategory[]
  assetDocuments                  AssetDocument[]
  assetHistory                    AssetHistory[]
  assetRequests                   AssetRequest[]
  assets                          Asset[]
  branches                        Branch[]
  designations                    Designation[]
  expenseClaims                   ExpenseClaim[]
  jobs                            Job[]
  lmsCourses                      LmsCourse[]
  lmsLearningPaths                LmsLearningPath[]
  payCycles                       PayCycle[]
  paymentCategories               PaymentCategory[]
  payrollGroups                   PayrollGroup[]
  payslips                        Payslip[]
  reimbursementTypes              ReimbursementType[]
  loanTypes                       LoanType[]
  roles                           Role[]
  salaryComponents                SalaryComponent[]
  salaryStructureHistories        SalaryStructureHistory[]
  salaryStructures                SalaryStructure[]
  taxDeclarations                 TaxDeclaration[]
  taxSections                     TaxSection[]
  user_types                      user_types[]
  config                          OrganizationConfig?

  @@map("organizations")
}

model OrganizationConfig {
  id                    Int          @id @default(autoincrement())
  organization_id       Int          @unique
  organization          Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  // Branding
  primary_color         String?      @default("#3B82F6")
  secondary_color       String?      @default("#1E40AF")
  custom_domain         String?

  // Security, SSO & MFA
  sso_provider          String?      @default("local")
  mfa_policy            String?      @default("email_otp")
  mfa_required_admins   Boolean      @default(true)

  // Billing Contacts
  billing_contact       String?
  finance_contact       String?
  technical_contact     String?
  legal_contact         String?

  // Preferences
  theme                 String?      @default("light")
  language              String?      @default("en-IN")
  date_format           String?      @default("DD/MM/YYYY")
  week_start_day        String?      @default("monday")
  default_landing_page  String?      @default("dashboard")

  // Notifications
  email_notifications    Boolean     @default(true)
  sms_notifications      Boolean     @default(false)
  in_app_notifications   Boolean     @default(true)
  webhooks_enabled       Boolean     @default(false)
  notification_frequency String?     @default("daily")

  // Maintenance Window
  maintenance_day       String?      @default("Saturday")
  maintenance_start     String?      @default("02:00")
  maintenance_end       String?      @default("06:00")

  // Backup & DR
  backup_frequency      String?      @default("daily")
  backup_retention_days Int?         @default(30)
  rpo_minutes           Int?         @default(60)
  rto_minutes           Int?         @default(240)

  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt

  @@map("organization_config")
}

model Branch {
  id                 Int                 @id @default(autoincrement())
  organization_id    Int
  branch_name        String
  branch_code        String
  address            String              @db.Text
  city               String
  state              String
  zip                String
  country            String
  time_zone          String
  tax_location       String
  gst                String?
  is_deleted         Boolean             @default(false)
  deleted_at         DateTime?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  organization       Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  department         department[]
  reimbursementTypes ReimbursementType[]
  loanTypes          LoanType[]

  @@index([organization_id])
  @@map("branches")
}

model LeavePolicy {
  id                   Int            @id @default(autoincrement())
  policy_name          String         @unique
  leave_type           String?
  days_per_year        Int            @default(0)
  carry_forward_days   Int            @default(0)
  accrual_rate         Decimal        @default(0.00) @db.Decimal(10, 2)
  leave_category       String         @default("paid")
  leave_color          String?
  eligibility_criteria String?        @db.Text
  description          String?        @db.Text
  requires_document    Boolean        @default(false)
  document_url         String?        @db.Text
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt
  leaveBalances        LeaveBalance[]
  leaveRequests        LeaveRequest[]

  @@map("leave_policies")
}

model LeaveRequest {
  id                   Int         @id @default(autoincrement())
  user_id              Int
  leave_policy_id      Int
  start_date           DateTime
  end_date             DateTime
  duration             Float
  reason               String?     @db.Text
  status               String      @default("PENDING")
  reporting_manager_id Int?
  approved_by          Int?
  rejection_reason     String?     @db.Text
  attachment_url       String?     @db.Text
  applied_at           DateTime    @default(now())
  created_at           DateTime    @default(now())
  updated_at           DateTime    @updatedAt
  approver             User?       @relation("LeaveApprover", fields: [approved_by], references: [id])
  leave_policy         LeavePolicy @relation(fields: [leave_policy_id], references: [id])
  manager              User?       @relation("ReportingManagerLeave", fields: [reporting_manager_id], references: [id])
  user                 User        @relation("UserLeaveRequests", fields: [user_id], references: [id])

  @@index([user_id])
  @@index([leave_policy_id])
  @@index([approved_by], map: "leave_requests_approved_by_fkey")
  @@index([reporting_manager_id], map: "leave_requests_reporting_manager_id_fkey")
  @@map("leave_requests")
}

model LeaveBalance {
  id              Int         @id @default(autoincrement())
  user_id         Int
  leave_policy_id Int
  balance         Float       @default(0)
  used            Float       @default(0)
  year            Int
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  leave_policy    LeavePolicy @relation(fields: [leave_policy_id], references: [id])
  user            User        @relation(fields: [user_id], references: [id])

  @@unique([user_id, leave_policy_id, year])
  @@index([leave_policy_id], map: "leave_balances_leave_policy_id_fkey")
  @@map("leave_balances")
}

model Attendance {
  id         Int       @id @default(autoincrement())
  user_id    Int
  date       DateTime  @db.Date
  check_in   DateTime?
  check_out  DateTime?
  work_hours Float     @default(0)
  status     String    @default("PRESENT")
  location   String?
  remarks    String?   @db.Text
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  user       User      @relation(fields: [user_id], references: [id])

  @@unique([user_id, date])
  @@index([user_id])
  @@map("attendance")
}

model CustomField {
  id         Int      @id @default(autoincrement())
  module     String
  label      String
  type       String
  options    Json?
  required   Boolean  @default(false)
  status     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("custom_fields")
}

model Integration {
  id         Int      @id @default(autoincrement())
  name       String
  provider   String
  config     Json?
  status     Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("integrations")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  action      String
  module      String
  description String?  @db.Text
  ip_address  String?
  created_at  DateTime @default(now())
  user        User?    @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([module])
  @@map("activity_logs")
}

model Notification {
  id             Int       @id @default(autoincrement())
  user_id        Int
  title          String
  message        String    @db.Text
  type           String    @default("INFO")
  metadata       Json?
  related_module String?
  related_id     Int?
  is_read        Boolean   @default(false)
  read_at        DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([is_read])
  @@map("notifications")
}

model SalaryComponent {
  id               Int                        @id @default(autoincrement())
  name             String
  type             String
  calculation_type String
  value            Decimal                    @db.Decimal(15, 2)
  is_taxable       Boolean                    @default(true)
  is_statutory     Boolean                    @default(false)
  is_default       Boolean                    @default(false)
  status           Boolean                    @default(true)
  created_at       DateTime                   @default(now())
  updated_at       DateTime                   @updatedAt
  organization_id  Int?
  organization     Organization?              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  structures       SalaryStructureComponent[]
  pending_changes  SalaryComponentChange[]

  @@unique([organization_id, name])
  @@map("salary_components")
}

model SalaryComponentChange {
  id                   Int            @id @default(autoincrement())
  salary_component_id  Int
  component            SalaryComponent @relation(fields: [salary_component_id], references: [id], onDelete: Cascade)
  proposed_name        String?
  proposed_type        String?
  proposed_calculation_type String?
  proposed_value       Decimal?       @db.Decimal(15, 2)
  proposed_is_taxable  Boolean?
  proposed_is_statutory Boolean?
  status               String         @default("pending") // pending | approved | rejected
  requested_by         Int?
  approved_by          Int?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  @@map("salary_component_changes")
}

model SalaryStructure {
  id              Int                        @id @default(autoincrement())
  name            String
  level           String                     @default("role")
  role_id         Int?
  employee_id     Int?
  status          Boolean                    @default(true)
  created_at      DateTime                   @default(now())
  updated_at      DateTime                   @updatedAt
  organization_id Int?
  groups          PayrollGroup[]
  components      SalaryStructureComponent[]
  histories       SalaryStructureHistory[]
  organization    Organization?              @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, name])
  @@map("salary_structures")
}

model SalaryStructureComponent {
  id                  Int             @id @default(autoincrement())
  salary_structure_id Int
  salary_component_id Int
  order               Int             @default(0)
  salary_component    SalaryComponent @relation(fields: [salary_component_id], references: [id], onDelete: Cascade)
  salary_structure    SalaryStructure @relation(fields: [salary_structure_id], references: [id], onDelete: Cascade)

  @@unique([salary_structure_id, salary_component_id])
  @@index([salary_component_id], map: "salary_structure_components_salary_component_id_fkey")
  @@map("salary_structure_components")
}

model PayrollGroup {
  id                  Int                 @id @default(autoincrement())
  name                String
  criteria            Json?
  salary_structure_id Int?
  status              Boolean             @default(true)
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  organization_id     Int?
  payment_category_id Int?
  organization        Organization?       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  payment_category    PaymentCategory?    @relation(fields: [payment_category_id], references: [id])
  salary_structure    SalaryStructure?    @relation(fields: [salary_structure_id], references: [id])
  reimbursement_types ReimbursementType[]
  userDetails         UserDetail[]

  @@unique([organization_id, name])
  @@index([payment_category_id], map: "payroll_groups_payment_category_id_fkey")
