model LmsModule {
  id          Int           @id @default(autoincrement())
  course_id   Int
  title       String
  order       Int           @default(0)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  description String?       @db.Text
  contents    LmsContent[]
  course      LmsCourse     @relation(fields: [course_id], references: [id], onDelete: Cascade)
  progress    LmsProgress[]

  @@index([course_id], map: "lms_modules_course_id_fkey")
  @@map("lms_modules")
}

model LmsContent {
  id             Int           @id @default(autoincrement())
  module_id      Int
  title          String
  content_type   String        @default("TEXT")
  content_url    String?       @db.Text
  content_body   String?       @db.LongText
  order          Int           @default(0)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  meeting_config Json?
  module         LmsModule     @relation(fields: [module_id], references: [id], onDelete: Cascade)
  progress       LmsProgress[]

  @@index([module_id], map: "lms_contents_module_id_fkey")
  @@map("lms_contents")
}

model LmsLearningPath {
  id                Int                     @id @default(autoincrement())
  organization_id   Int
  title             String
  description       String?                 @db.Text
  thumbnail_url     String?                 @db.Text
  created_at        DateTime                @default(now())
  updated_at        DateTime                @updatedAt
  auto_assign_rules Json?
  assignments       LmsAssignment[]
  courses           LmsLearningPathCourse[]
  organization      Organization            @relation(fields: [organization_id], references: [id])

  @@index([organization_id], map: "lms_learning_paths_organization_id_fkey")
  @@map("lms_learning_paths")
}

model LmsLearningPathCourse {
  id               Int             @id @default(autoincrement())
  learning_path_id Int
  course_id        Int
  order            Int             @default(0)
  course           LmsCourse       @relation(fields: [course_id], references: [id], onDelete: Cascade)
  learning_path    LmsLearningPath @relation(fields: [learning_path_id], references: [id], onDelete: Cascade)

  @@unique([learning_path_id, course_id])
  @@index([course_id], map: "lms_learning_path_courses_course_id_fkey")
  @@map("lms_learning_path_courses")
}

model LmsAssignment {
  id               Int              @id @default(autoincrement())
  user_id          Int
  course_id        Int?
  learning_path_id Int?
  assigned_by      Int?
  status           String           @default("ASSIGNED")
  due_date         DateTime?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  course           LmsCourse?       @relation(fields: [course_id], references: [id], onDelete: Cascade)
  learning_path    LmsLearningPath? @relation(fields: [learning_path_id], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([course_id], map: "lms_assignments_course_id_fkey")
  @@index([learning_path_id], map: "lms_assignments_learning_path_id_fkey")
  @@index([user_id], map: "lms_assignments_user_id_fkey")
  @@map("lms_assignments")
}

model LmsProgress {
  id              Int        @id @default(autoincrement())
  user_id         Int
  module_id       Int
  content_id      Int
  completed       Boolean    @default(false)
  time_spent      Int        @default(0)
  completed_at    DateTime?
  updated_at      DateTime   @updatedAt
  engagement_data Json?
  content         LmsContent @relation(fields: [content_id], references: [id], onDelete: Cascade)
  module          LmsModule  @relation(fields: [module_id], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, content_id])
  @@index([content_id], map: "lms_progress_content_id_fkey")
  @@index([module_id], map: "lms_progress_module_id_fkey")
  @@map("lms_progress")
}

model LmsQuiz {
  id            Int           @id @default(autoincrement())
  course_id     Int
  title         String
  description   String?       @db.Text
  passing_score Int           @default(70)
  time_limit    Int?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  max_attempts  Int           @default(0)
  questions     LmsQuestion[]
  course        LmsCourse     @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@index([course_id], map: "lms_quizzes_course_id_fkey")
  @@map("lms_quizzes")
}

model LmsQuestion {
  id             Int      @id @default(autoincrement())
  quiz_id        Int
  question_text  String   @db.Text
  question_type  String   @default("MCQ")
  options        Json
  correct_answer Json
  explanation    String?  @db.Text
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  quiz           LmsQuiz  @relation(fields: [quiz_id], references: [id], onDelete: Cascade)

  @@index([quiz_id], map: "lms_questions_quiz_id_fkey")
  @@map("lms_questions")
}

model LmsQuizAttempt {
  id           Int      @id @default(autoincrement())
  user_id      Int
  quiz_id      Int
  score        Int
  status       String
  attempt_date DateTime @default(now())
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "lms_quiz_attempts_user_id_fkey")
  @@map("lms_quiz_attempts")
}

model LmsCertificate {
  id             Int       @id @default(autoincrement())
  user_id        Int
  course_id      Int
  certificate_id String    @unique
  issue_date     DateTime  @default(now())
  expiry_date    DateTime?
  created_at     DateTime  @default(now())
  course         LmsCourse @relation(fields: [course_id], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([course_id], map: "lms_certificates_course_id_fkey")
  @@index([user_id], map: "lms_certificates_user_id_fkey")
  @@map("lms_certificates")
}

model department {
  id                   Int                 @id @default(autoincrement())
  department_name      String
  department_code      String
  branch_id            Int
  description          String?
  parent_department_id Int?
  annual_budget        Decimal?
  manager_id           Int?
  cost_center          String?
  is_deleted           Boolean             @default(false)
  deleted_at           DateTime?
  created_at           DateTime            @default(now())
  updated_at           DateTime            @default(now()) @updatedAt
  branches             Branch              @relation(fields: [branch_id], references: [id], map: "Department_branch_id_fkey")
  users                User?               @relation(fields: [manager_id], references: [id], map: "Department_manager_id_fkey")
  designations         Designation[]
  reimbursementTypes   ReimbursementType[]
  loanTypes            LoanType[]
  team                 team[]
  userDetails          UserDetail[]
  company_news_departments company_news_departments[]

  @@index([branch_id], map: "Department_branch_id_idx")
  @@index([manager_id], map: "Department_manager_id_fkey")
}

model team {
  id            Int          @id @default(autoincrement())
  department_id Int
  team_name     String
  description   String?
  team_lead_id  Int?
  is_deleted    Boolean      @default(false)
  deleted_at    DateTime?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @default(now()) @updatedAt
  department    department   @relation(fields: [department_id], references: [id], map: "Team_department_id_fkey")
  users         User?        @relation(fields: [team_lead_id], references: [id], map: "Team_team_lead_id_fkey")
  userDetails   UserDetail[]

  @@index([department_id], map: "Team_department_id_fkey")
  @@index([team_lead_id], map: "Team_team_lead_id_fkey")
}

model Designation {
  id                    Int           @id @default(autoincrement())
  organization_id       Int?
  designation_name      String
  designation_code      String
  description           String?       @db.Text
  parent_designation_id           Int?
  secondary_parent_designation_id  Int?
  secondary_reporting_employee_id  Int?
  department_id                    Int?
  is_deleted                       Boolean       @default(false)
  deleted_at                       DateTime?
  created_at                       DateTime      @default(now())
  updated_at                       DateTime      @default(now()) @updatedAt
  parent                           Designation?  @relation("DesignationTree", fields: [parent_designation_id], references: [id], map: "Designation_parent_designation_id_fkey")
  secondary_parent                 Designation?  @relation("SecondaryDesignationTree", fields: [secondary_parent_designation_id], references: [id])
  secondary_reporting_employee     UserDetail?   @relation("SecondaryReportingEmployee", fields: [secondary_reporting_employee_id], references: [id])
  children                         Designation[] @relation("DesignationTree")
  secondary_children               Designation[] @relation("SecondaryDesignationTree")
  department                       department?   @relation(fields: [department_id], references: [id])
  organizations                    Organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  userDetails                      UserDetail[]
  loanTypes                        LoanType[]

  @@unique([organization_id, designation_code])
  @@unique([organization_id, designation_name])
  @@index([parent_designation_id], map: "Designation_parent_designation_id_idx")
  @@index([secondary_parent_designation_id], map: "Designation_secondary_parent_designation_id_idx")
  @@index([secondary_reporting_employee_id], map: "Designation_secondary_reporting_employee_id_idx")
  @@index([department_id], map: "Designation_department_id_idx")
  @@index([organization_id], map: "Designation_organization_id_idx")
  @@map("designations")
}

model Job {
  id                    Int                    @id @default(autoincrement())
  organization_id       Int
  title                 String
  description           String                 @db.Text
  department            String
  location              String
  employment_type       String
  experience_level      String
  experience_required   String?
  openings_count        Int                    @default(1)
  remote_option         String
  salary_type           String
  currency              String                 @default("INR")
  min_salary            Decimal?               @db.Decimal(15, 2)
  max_salary            Decimal?               @db.Decimal(15, 2)
  salary_period         String?
  job_summary           String                 @db.Text
  responsibilities      Json?
  requirements          Json?
  required_skills       Json?
  preferred_skills      Json?
  benefits              Json?
  hiring_manager_id     Int?
  assigned_recruiter_id Int?
  application_deadline  DateTime?
  target_start_date     DateTime?
  interview_rounds      Int?
  travel_required       String?
  status                String                 @default("OPEN")
  is_deleted            Boolean                @default(false)
  deleted_at            DateTime?
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  applications          CandidateApplication[]
  interviews            Interview[]
  organization          Organization           @relation(fields: [organization_id], references: [id])
  offers                Offer[]

  @@index([id])
  @@index([status])
  @@index([organization_id], map: "jobs_organization_id_fkey")
  @@map("jobs")
}

model Interview {
  id               Int                    @id @default(autoincrement())
  uuid             String                 @unique @default(uuid())
  candidate_id     Int
  job_id           Int
  application_id   Int?
  round_number     Int
  type             InterviewType
  scheduled_at     DateTime
  duration_minutes Int
  meeting_link     String?
  status           InterviewStatus        @default(SCHEDULED)
  notes            String?
  created_at       DateTime               @default(now())
  updated_at       DateTime               @updatedAt
  is_deleted       Boolean                @default(false)
  deleted_at       DateTime?
  events           InterviewEvent[]
  feedback         InterviewFeedback?
  interviewers     InterviewInterviewer[]
  application      CandidateApplication?  @relation(fields: [application_id], references: [id])
  candidate        Candidate              @relation(fields: [candidate_id], references: [id])
  job              Job                    @relation(fields: [job_id], references: [id])

  @@index([candidate_id])
  @@index([job_id])
  @@index([application_id])
  @@index([status])
  @@index([scheduled_at])
  @@map("interviews")
}

model InterviewInterviewer {
  interview_id Int
  user_id      Int
  role         String
  interview    Interview @relation(fields: [interview_id], references: [id])
  user         User      @relation(fields: [user_id], references: [id])

  @@id([interview_id, user_id])
  @@index([user_id], map: "interview_interviewers_user_id_fkey")
  @@map("interview_interviewers")
}

model InterviewFeedback {
  id                     Int            @id @default(autoincrement())
  interview_id           Int            @unique
  technical_rating       Int            @default(0)
  communication_rating   Int            @default(0)
  problem_solving_rating Int            @default(0)
  culture_fit_rating     Int            @default(0)
  recommendation         Recommendation
  strengths              String?
  weaknesses             String?
  additional_notes       String?
  created_at             DateTime       @default(now())
  updated_at             DateTime       @updatedAt
  interview              Interview      @relation(fields: [interview_id], references: [id])

  @@index([interview_id])
  @@map("interview_feedbacks")
}

model InterviewEvent {
  id           Int                @id @default(autoincrement())
  interview_id Int
  event_type   InterviewEventType
  actor_id     Int?
  actor_role   String?
  timestamp    DateTime           @default(now())
  details      Json?
  interview    Interview          @relation(fields: [interview_id], references: [id])

  @@index([interview_id])
  @@map("interview_events")
}

model Candidate {
  id                  Int                    @id @default(autoincrement())
  uuid                String                 @unique @default(uuid())
  organization_id     Int?
  first_name          String
  last_name           String
  email               String                 @unique
  phone               String?
  joining_date        DateTime?
  otp_secret          String?
  otp_attempts        Int                    @default(0)
  policies_accepted   Boolean                @default(false)
  bank_details        Json?
  is_draft            Boolean                @default(false)
  experience_history  Json?
  education_history   Json?
  gender              String?
  dob                 DateTime?
  address             String?
  experience_years    Decimal?               @db.Decimal(5, 2)
  current_company     String?
  current_designation String?
  current_location    String?
  linkedin_url        String?
  portfolio_url       String?
  github_url          String?
  current_ctc         Decimal?               @db.Decimal(15, 2)
  expected_ctc        Decimal?               @db.Decimal(15, 2)
  notice_period_days  Int?
  skills              String?
  resume_url          String?
  source              String?
  highest_degree      String?
  specialization      String?
  university          String?
  graduation_year     Int?
  gpa_percentage      Decimal?               @db.Decimal(5, 2)
  is_deleted          Boolean                @default(false)
  deleted_at          DateTime?
  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt
  bgv_cases           BgvCase[]
  applications        CandidateApplication[]
  documents           CandidateDocument[]
  interviews          Interview[]
  offers              Offer[]

  @@index([email])
  @@index([uuid])
  @@map("candidates")
}

model CandidateApplication {
  id           Int         @id @default(autoincrement())
  uuid         String      @unique @default(uuid())
  candidate_id Int
  job_id       Int
  status       String      @default("APPLIED")
  answers      Json?
  version      Int         @default(1)
  is_deleted   Boolean     @default(false)
  deleted_at   DateTime?
  applied_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  bgv_case     BgvCase?
  candidate    Candidate   @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  job          Job         @relation(fields: [job_id], references: [id], onDelete: Cascade)
  interviews   Interview[]
  offers       Offer[]

  @@index([candidate_id])
  @@index([job_id])
  @@index([uuid])
  @@index([status])
  @@map("candidate_applications")
}

model Offer {
  id             String               @id @default(uuid())
  candidate_id   Int
  job_id         Int
  application_id Int
  recruiter_id   Int?
  hr_reviewer_id Int?
  status         OfferStatus          @default(DRAFT)
  expiry_date    DateTime
  joining_date   DateTime
  is_deleted     Boolean              @default(false)
  deleted_at     DateTime?
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  negotiations   Negotiation[]
  versions       OfferVersion[]
  application    CandidateApplication @relation(fields: [application_id], references: [id])
  candidate      Candidate            @relation(fields: [candidate_id], references: [id])
  reviewer       User?                @relation("ReviewerOffers", fields: [hr_reviewer_id], references: [id])
  job            Job                  @relation(fields: [job_id], references: [id])
  recruiter      User?                @relation("RecruiterOffers", fields: [recruiter_id], references: [id])

  @@index([candidate_id])
  @@index([job_id])
  @@index([application_id])
  @@index([status])
  @@index([expiry_date])
  @@index([hr_reviewer_id], map: "offers_hr_reviewer_id_fkey")
  @@index([recruiter_id], map: "offers_recruiter_id_fkey")
  @@map("offers")
}

model OfferVersion {
  id                String                  @id @default(uuid())
  offer_id          String
  version_number    Int                     @default(1)
  created_by_id     Int
  created_at        DateTime                @default(now())
  joining_date      DateTime
  expiry_date       DateTime
  work_location     String
  work_mode         String
  probation_period  Int                     @default(0)
  reporting_manager String
  notice_clauses    String?                 @db.Text
  confidentiality   String?                 @db.Text
  employment_conds  String?                 @db.Text
  additional_terms  String?                 @db.Text
  compensation      CompensationComponent[]
  documents         OfferDocument[]
  created_by        User                    @relation(fields: [created_by_id], references: [id])
  offer             Offer                   @relation(fields: [offer_id], references: [id])

  @@index([offer_id])
  @@index([created_by_id], map: "offer_versions_created_by_id_fkey")
  @@map("offer_versions")
}

model CompensationComponent {
  id               String                @id @default(uuid())
  offer_version_id String
  type             String
  amount           Decimal               @db.Decimal(15, 2)
  currency         String                @default("INR")
  frequency        CompensationFrequency @default(ANNUAL)
  description      String?
  offer_version    OfferVersion          @relation(fields: [offer_version_id], references: [id], onDelete: Cascade)

  @@index([offer_version_id])
  @@map("compensation_components")
}

model OfferDocument {
  id               String       @id @default(uuid())
  offer_version_id String
  file_path        String       @db.Text
  original_name    String
  mime_type        String
  token            String?      @unique
  created_at       DateTime     @default(now())
  offer_version    OfferVersion @relation(fields: [offer_version_id], references: [id], onDelete: Cascade)

  @@index([offer_version_id])
  @@map("offer_documents")
}

model Negotiation {
  id             String   @id @default(uuid())
  offer_id       String
  requester_role String
  comment        String   @db.Text
  created_at     DateTime @default(now())
  offer          Offer    @relation(fields: [offer_id], references: [id])

  @@index([offer_id])
  @@map("negotiations")
}

model OfferEvent {
  id         String   @id @default(uuid())
  offer_id   String
  event_type String
  actor_id   Int?
  actor_role String?
  timestamp  DateTime @default(now())
  details    Json?

  @@index([offer_id])
  @@map("offer_events")
}

model CandidateDocument {
  id            Int       @id @default(autoincrement())
  candidate_id  Int
  document_type String
  file_url      String    @db.Text
  status        String    @default("PENDING_VERIFICATION")
  uploaded_at   DateTime  @default(now())
  verified_at   DateTime?
  candidate     Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  @@index([candidate_id])
  @@map("candidate_documents")
}

model AuditEvent {
  id             Int      @id @default(autoincrement())
  actor_id       Int?
  actor_type     String?
  entity_type    String
  entity_id      Int
  action_type    String
  previous_state String?
  new_state      String?
  comments       String?  @db.Text
  ip_address     String?
  correlation_id String?
  timestamp      DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([actor_id])
  @@map("audit_events")
}

model Survey {
  id          String           @id @default(uuid())
  title       String
  description String?
  is_active       Boolean          @default(true)
  access          String           @default("private")
  survey_password String?
  theme_preset    String?
  theme_config    String?       @db.Text
  start_date      DateTime?
  end_date        DateTime?
  target_department String?     @default("All Departments")
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  created_by      Int
  is_deleted      Boolean          @default(false)
  deleted_at      DateTime?
  questions   Question[]
  responses   SurveyResponse[]
  cloned_from_id  String?
  is_clone        Boolean          @default(false)
  cloned_from     Survey?          @relation("SurveyClone", fields: [cloned_from_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  cloned_surveys  Survey[]         @relation("SurveyClone")
  creator     User             @relation(fields: [created_by], references: [id])

  @@index([created_by])
  @@map("surveys")
}

model Question {
  id                 Int          @id @default(autoincrement())
  surveyId           String
  type               QuestionType
  label              String
  order              Int
  required           Boolean      @default(false)
  parent_question_id Int?
  trigger_option_id  Int?
  is_deleted         Boolean      @default(false)
  deleted_at         DateTime?
  answers            Answer[]
  options            Option[]
  survey             Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  parentQuestion     Question?    @relation("QuestionCondition", fields: [parent_question_id], references: [id])
  childQuestions     Question[]   @relation("QuestionCondition")
  triggerOption      Option?      @relation("TriggerOption", fields: [trigger_option_id], references: [id])

  @@index([surveyId])
  @@index([parent_question_id])
  @@map("questions")
}

model Option {
  id                 Int        @id @default(autoincrement())
  questionId         Int
  label              String
  value              String
  order              Int
  is_deleted         Boolean    @default(false)
  deleted_at         DateTime?
  answers            Answer[]
  question           Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  triggeredQuestions Question[] @relation("TriggerOption")

  @@index([questionId])
  @@map("options")
}

model SurveyResponse {
  id           Int       @id @default(autoincrement())
  surveyId     String
  userId       Int?
  submitted_at DateTime  @default(now())
  is_deleted   Boolean   @default(false)
  deleted_at   DateTime?
  answers      Answer[]
  survey       Survey    @relation(fields: [surveyId], references: [id])
  user         User?     @relation(fields: [userId], references: [id])

  @@index([surveyId, userId])
  @@index([userId], map: "survey_responses_userId_fkey")
  @@map("survey_responses")
}

model Answer {
  id               Int            @id @default(autoincrement())
  responseId       Int
  questionId       Int
  valueText        String?        @db.Text
  valueNumber      Float?
  selectedOptionId Int?
  is_deleted       Boolean        @default(false)
  deleted_at       DateTime?
  question         Question       @relation(fields: [questionId], references: [id])
  response         SurveyResponse @relation(fields: [responseId], references: [id])
  selectedOption   Option?        @relation(fields: [selectedOptionId], references: [id])

  @@index([responseId])
  @@index([questionId])
  @@index([selectedOptionId], map: "answers_selectedOptionId_fkey")
  @@map("answers")
}

model BgvCase {
  id             String               @id @default(uuid())
  application_id Int                  @unique
  candidate_id   Int
  status         String               @default("BGV_INITIATED")
  risk_score     Int                  @default(0)
  risk_category  String               @default("LOW")
  hr_reviewer_id Int?
  vendor_ref_id  String?
  sla_due_date   DateTime?
  summary        String?              @db.Text
  is_deleted     Boolean              @default(false)
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  audit_events   BgvAuditEvent[]
  application    CandidateApplication @relation(fields: [application_id], references: [id], onDelete: Cascade)
  candidate      Candidate            @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  hr_reviewer    User?                @relation("BgvReviewer", fields: [hr_reviewer_id], references: [id])
  documents      BgvDocument[]
  reviews        BgvReview[]
  risk_flags     BgvRiskFlag[]
  verifications  BgvVerification[]

  @@index([application_id])
  @@index([candidate_id])
  @@index([status])
  @@index([hr_reviewer_id], map: "bgv_cases_hr_reviewer_id_fkey")
  @@map("bgv_cases")
}

model BgvVerification {
  id          String        @id @default(uuid())
  bgv_case_id String
  type        String
  status      String        @default("PENDING")
  verified_by String?
  remarks     String?       @db.Text
  is_deleted  Boolean       @default(false)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  documents   BgvDocument[]
  bgv_case    BgvCase       @relation(fields: [bgv_case_id], references: [id], onDelete: Cascade)

  @@index([bgv_case_id])
  @@map("bgv_verifications")
}

model BgvDocument {
  id                  String           @id @default(uuid())
  bgv_case_id         String
  bgv_verification_id String?
  document_type       String
  file_url            String           @db.Text
  original_name       String
  mime_type           String
  status              String           @default("UPLOADED")
  rejection_reason    String?          @db.Text
  is_deleted          Boolean          @default(false)
  created_at          DateTime         @default(now())
  bgv_case            BgvCase          @relation(fields: [bgv_case_id], references: [id], onDelete: Cascade)
  verification        BgvVerification? @relation(fields: [bgv_verification_id], references: [id])

  @@index([bgv_case_id])
  @@index([bgv_verification_id], map: "bgv_documents_bgv_verification_id_fkey")
  @@map("bgv_documents")
}

model BgvReview {
  id          String   @id @default(uuid())
  bgv_case_id String
  reviewer_id Int
  decision    String
  remarks     String   @db.Text
  created_at  DateTime @default(now())
  bgv_case    BgvCase  @relation(fields: [bgv_case_id], references: [id], onDelete: Cascade)
  reviewer    User     @relation(fields: [reviewer_id], references: [id])

  @@index([bgv_case_id])
  @@index([reviewer_id], map: "bgv_reviews_reviewer_id_fkey")
  @@map("bgv_reviews")
}

model BgvRiskFlag {
  id           String   @id @default(uuid())
  bgv_case_id  String
  rule_name    String
  score_impact Int
  description  String   @db.Text
  created_at   DateTime @default(now())
  bgv_case     BgvCase  @relation(fields: [bgv_case_id], references: [id], onDelete: Cascade)

  @@index([bgv_case_id])
  @@map("bgv_risk_flags")
}

model BgvAuditEvent {
  id             String   @id @default(uuid())
  bgv_case_id    String
  actor_id       Int?
  actor_type     String
  action_type    String
  old_value      String?  @db.Text
  new_value      String?  @db.Text
  reason         String?  @db.Text
  ip_address     String?
  correlation_id String?
  created_at     DateTime @default(now())
  bgv_case       BgvCase  @relation(fields: [bgv_case_id], references: [id], onDelete: Cascade)

  @@index([bgv_case_id])
  @@map("bgv_audit_events")
}

model Loan {
  id                     Int        @id @default(autoincrement())
  userDetailId           Int
  principalAmount        Decimal    @db.Decimal(15, 2)
  monthlyRecovery        Decimal    @db.Decimal(15, 2)
  outstandingBalance     Decimal    @db.Decimal(15, 2)
  isActive               Boolean    @default(true)
  status                 String     @default("PENDING_MANAGER")
  reason                 String?    @db.Text
  reporting_manager_id   Int?
  manager_remarks        String?    @db.Text
  manager_approved_at    DateTime?
  hr_approved_by         Int?
  hr_remarks             String?    @db.Text
  hr_approved_at         DateTime?
  finance_approved_by    Int?
  finance_remarks        String?    @db.Text
  finance_approved_at    DateTime?
  disbursed_at           DateTime?
  disbursement_reference String?    @db.Text
  created_at             DateTime   @default(now())
  updated_at             DateTime   @updatedAt
  userDetail             UserDetail @relation(fields: [userDetailId], references: [id])
  reporting_manager      User?      @relation("LoanReportingManager", fields: [reporting_manager_id], references: [id])
  hr_approver            User?      @relation("LoanHRApprover", fields: [hr_approved_by], references: [id])
  finance_approver       User?      @relation("LoanFinanceApprover", fields: [finance_approved_by], references: [id])

  @@index([userDetailId])
  @@index([reporting_manager_id])
  @@index([status])
  @@map("loans")
}

model Advance {
  id                     Int        @id @default(autoincrement())
  userDetailId           Int
  principalAmount        Decimal    @db.Decimal(15, 2)
  monthlyRecovery        Decimal    @db.Decimal(15, 2)
  outstandingBalance     Decimal    @db.Decimal(15, 2)
  isActive               Boolean    @default(true)
  status                 String     @default("PENDING_MANAGER")
  reason                 String?    @db.Text
  reporting_manager_id   Int?
  manager_remarks        String?    @db.Text
  manager_approved_at    DateTime?
  hr_approved_by         Int?
  hr_remarks             String?    @db.Text
  hr_approved_at         DateTime?
  finance_approved_by    Int?
  finance_remarks        String?    @db.Text
  finance_approved_at    DateTime?
  disbursed_at           DateTime?
  disbursement_reference String?    @db.Text
  created_at             DateTime   @default(now())
  updated_at             DateTime   @updatedAt
  userDetail             UserDetail @relation(fields: [userDetailId], references: [id])
  reporting_manager      User?      @relation("AdvanceReportingManager", fields: [reporting_manager_id], references: [id])
  hr_approver            User?      @relation("AdvanceHRApprover", fields: [hr_approved_by], references: [id])
  finance_approver       User?      @relation("AdvanceFinanceApprover", fields: [finance_approved_by], references: [id])

  @@index([userDetailId])
  @@index([reporting_manager_id])
  @@index([status])
  @@map("advances")
}

// ─── Configurable Loans & Advances Module ─────────────────────────────

model LoanType {
  id                   Int                  @id @default(autoincrement())
  name                 String               @db.VarChar(100)
  code                 String               @unique @db.VarChar(20)
  category             String               @default("LOAN") // LOAN | ADVANCE
  description          String?              @db.Text
  minAmount            Decimal              @db.Decimal(15, 2) @default(0)
  maxAmount            Decimal              @db.Decimal(15, 2) @default(0)
  interestRate         Decimal              @db.Decimal(5, 2) @default(0)
  repaymentMethod      String               @default("EMI") // EMI | SALARY_DEDUCTION | ONE_TIME
  maxTenure            Int                  @default(12)
  installments         Int                  @default(1)
  requiresDocuments    Boolean              @default(false)
  isActive             Boolean              @default(true)
  sortOrder            Int                  @default(0)
  effectiveDate        DateTime?
  expiryDate           DateTime?
  maxApplicationsPerPeriod Int?
  period               String               @default("Lifetime") // Monthly | Quarterly | Annually | Lifetime
  department_id        Int?
  designation_id       Int?
  branch_id            Int?
  role_id              Int?
  organization_id      Int?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  department           department?          @relation(fields: [department_id], references: [id])
  designation          Designation?         @relation(fields: [designation_id], references: [id])
  branch               Branch?              @relation(fields: [branch_id], references: [id])
  role                 Role?                @relation(fields: [role_id], references: [id])
  organization         Organization?        @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  eligibilityRules     LoanEligibilityRule[]
  approvalWorkflow     LoanApprovalWorkflow[]
  applications         LoanApplication[]

  @@index([department_id])
  @@index([designation_id])
  @@index([branch_id])
  @@index([role_id])
  @@index([organization_id])
  @@map("loan_types")
}

model LoanEligibilityRule {
  id                 Int      @id @default(autoincrement())
  loanTypeId         Int
  ruleType           String   @db.VarChar(50) // employment_type | min_service_months | min_salary | max_salary | departments | designations | grades | locations | max_active_loans | confirmation_required
  ruleValue          String   @db.Text // JSON string for array values, or plain value for numeric
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  loanType           LoanType @relation(fields: [loanTypeId], references: [id], onDelete: Cascade)

  @@index([loanTypeId])
  @@map("loan_eligibility_rules")
}

model LoanApprovalWorkflow {
  id                 Int      @id @default(autoincrement())
  loanTypeId         Int
  stepOrder          Int
  roleName           String   @db.VarChar(100) // Role name required for this step
  isRequired         Boolean  @default(true)
  createdAt          DateTime @default(now())

  loanType           LoanType @relation(fields: [loanTypeId], references: [id], onDelete: Cascade)

  @@unique([loanTypeId, stepOrder])
  @@index([loanTypeId])
  @@map("loan_approval_workflows")
}

model LoanApplication {
  id                 Int      @id @default(autoincrement())
  applicationNumber  String   @unique @db.VarChar(30)
  userDetailId       Int
  loanTypeId         Int
  requestedAmount    Decimal  @db.Decimal(15, 2)
  approvedAmount     Decimal? @db.Decimal(15, 2)
  tenure             Int
  monthlyEmi         Decimal? @db.Decimal(15, 2)
  interestRate       Decimal  @db.Decimal(5, 2) @default(0)
  totalPayable       Decimal? @db.Decimal(15, 2)
  outstandingBalance Decimal  @db.Decimal(15, 2) @default(0)
  paidAmount         Decimal  @db.Decimal(15, 2) @default(0)
  reason             String?  @db.Text
  status             String   @default("DRAFT") // DRAFT | SUBMITTED | PENDING_STEP_1..N | APPROVED | REJECTED | SETTLED | DISBURSED | WITHDRAWN
  currentStep        Int      @default(0)
  workflowSnapshot   String?  @db.Text
  startDate          DateTime?
  endDate            DateTime?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userDetail         UserDetail @relation(fields: [userDetailId], references: [id])
  loanType           LoanType @relation(fields: [loanTypeId], references: [id])
  approvals          LoanApproval[]
  repaymentSchedule  LoanRepaymentSchedule[]
  documents          LoanDocument[]

  @@index([userDetailId])
  @@index([loanTypeId])
  @@index([status])
  @@map("loan_applications")
}

model LoanApproval {
  id                 Int      @id @default(autoincrement())
  applicationId      Int
  stepOrder          Int
  approverId         Int
  status             String   @default("PENDING") // PENDING | APPROVED | REJECTED
  remarks            String?  @db.Text
  actionAt           DateTime?
  createdAt          DateTime @default(now())

  application        LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  approver           User       @relation(fields: [approverId], references: [id])

  @@index([applicationId])
  @@index([approverId])
  @@map("loan_approvals")
}

model LoanRepaymentSchedule {
  id                 Int      @id @default(autoincrement())
  applicationId      Int
  installmentNo      Int
  dueDate            DateTime
  amount             Decimal  @db.Decimal(15, 2)
  principalPortion   Decimal  @db.Decimal(15, 2) @default(0)
  interestPortion    Decimal  @db.Decimal(15, 2) @default(0)
  status             String   @default("PENDING") // PENDING | PAID | OVERDUE | PARTIAL
  paidAmount         Decimal  @db.Decimal(15, 2) @default(0)
  paidDate           DateTime?
  createdAt          DateTime @default(now())

  application        LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("loan_repayment_schedules")
}

model LoanDocument {
  id                 Int      @id @default(autoincrement())
  applicationId      Int
  fileName           String   @db.VarChar(255)
  fileUrl            String   @db.VarChar(500)
  fileType           String?  @db.VarChar(50)
  fileSize           Int?
  uploadedAt         DateTime @default(now())

  application        LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("loan_documents")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  module    String   @db.VarChar(50)
  action    String   @db.VarChar(50)
  entityId  String
  actorId   Int
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([module, action])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Document {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?  @db.Text
  category        String
  tab             String   @default("all")
  file_url        String
  file_type       String?
  file_size       Int?
  downloads_count Int      @default(0)
  views_count     Int      @default(0)
  is_restricted   Boolean  @default(false)
  tags            Json?
  version         String   @default("1.0")
  user_id         Int?
  uploaded_by     Int
  target_department String?  @default("All Departments")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  uploader        User     @relation("DocumentUploader", fields: [uploaded_by], references: [id])
  owner           User?    @relation("DocumentOwner", fields: [user_id], references: [id])

  @@index([uploaded_by], map: "documents_uploaded_by_fkey")
  @@index([user_id], map: "documents_user_id_fkey")
  @@map("documents")
}

model tenants {
  id        Int    @id @default(autoincrement())
  name      String
  editionId Int
}

model editions {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  description String?
}

model edition_modules {
  editionId       Int
  featureModuleId Int

  @@id([editionId, featureModuleId])
}

model feature_modules {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  description String?
}

model tenant_feature_overrides {
  tenantId        Int
  featureModuleId Int
  enabled         Boolean @default(true)

  @@id([tenantId, featureModuleId])
}

model announcements {
  id         Int       @id @default(autoincrement())
  title      String
  content    String    @db.Text
  priority   String    @default("normal")
  is_active  Boolean   @default(true)
  expires_at DateTime?
  created_by Int
  created_at DateTime  @default(now())
  updated_at DateTime
  users      User      @relation(fields: [created_by], references: [id])

  @@index([created_by], map: "announcements_created_by_fkey")
}

model company_news {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  image_url  String?
  access_type String  @default("public") // "public" | "department"
  status     String   @default("draft")   // "draft" | "published" | "archived"
  created_by Int
  created_at DateTime @default(now())
  updated_at DateTime
  users      User     @relation(fields: [created_by], references: [id])
  departments company_news_departments[]

  @@index([created_by], map: "company_news_created_by_fkey")
