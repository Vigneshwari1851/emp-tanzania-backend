model company_news_departments {
  id            Int        @id @default(autoincrement())
  company_news_id Int
  department_id Int
  company_news  company_news @relation(fields: [company_news_id], references: [id], onDelete: Cascade)
  department    department   @relation(fields: [department_id], references: [id])

  @@index([company_news_id], map: "cnd_news_id_idx")
  @@index([department_id], map: "cnd_dept_id_idx")
  @@unique([company_news_id, department_id], map: "cnd_unique_pair")
}

model holidays {
  id         Int      @id @default(autoincrement())
  name       String
  date       DateTime
  year       Int
  type       String   @default("public")
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime

  @@unique([name, year])
}

model user_type_permissions {
  id            Int        @id @default(autoincrement())
  user_type_id  Int
  permission_id Int
  created_at    DateTime   @default(now())
  permissions   Permission @relation(fields: [permission_id], references: [id])
  user_types    user_types @relation(fields: [user_type_id], references: [id])

  @@unique([user_type_id, permission_id])
  @@index([permission_id], map: "user_type_permissions_permission_id_fkey")
}

model user_types {
  id                    Int                     @id @default(autoincrement())
  organization_id       Int
  name                  String
  description           String?                 @db.Text
  system_key            String
  created_at            DateTime                @default(now())
  user_details          UserDetail[]
  user_type_permissions user_type_permissions[]
  organizations         Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, name])
  @@index([organization_id])
}

