// OTP & Consent module – Prisma models

/// Secure, single‑use onboarding token generated after an offer is accepted.
model OnboardingToken {
  id           String   @id @default(uuid())
  candidateId  Int                                 // FK → Candidate
  offerId      Int                                 // FK → Offer (the accepted offer)
  tokenHash    String   @unique                     // bcrypt/argon2 hash of the signed JWT
  expiresAt    DateTime                             // token expiry
  usedAt       DateTime?                            // set when token is consumed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  candidate Candidate @relation(fields: [candidateId], references: [id])
  offer     Offer     @relation(fields: [offerId], references: [id])

  @@index([candidateId])
  @@index([offerId])
  @@map("onboarding_tokens")
}

/// Holds a hashed OTP, expiry, attempt counters & lockout information.
model OtpSession {
  id           String   @id @default(uuid())
  candidateId  Int                                 // FK → Candidate
  tokenId      String   @unique                     // FK → OnboardingToken.id
  otpHash      String                               // hashed OTP (bcrypt/argon2)
  expiresAt    DateTime                             // OTP expiry
  attempts     Int       @default(0)               // verification attempts
  lockedUntil DateTime?                            // lockout expiry after max attempts
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  candidate Candidate @relation(fields: [candidateId], references: [id])
  token     OnboardingToken @relation(fields: [tokenId], references: [id])

  @@index([candidateId])
  @@map("otp_sessions")
}

/// Individual OTP verification attempts – useful for audit & rate limiting.
model OtpAttempt {
  id          String   @id @default(uuid())
  sessionId   String                                 // FK → OtpSession.id
  ipAddress   String?
  userAgent   String?
  success     Boolean
  attemptedAt DateTime @default(now())

  // Relations
  session OtpSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("otp_attempts")
}

/// Versioned consent documents (privacy, BGV, employment terms, etc.).
model ConsentVersion {
  id        String   @id @default(uuid())
  name      String                                 // e.g. "Privacy Policy"
  version   Int      @default(1)
  content   String                                 // full text / markdown
  checksum  String                                 // SHA‑256 of content for integrity
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, version])
  @@map("consent_versions")
}

/// Record of a candidate's acceptance or decline of a consent version.
model ConsentRecord {
  id               String   @id @default(uuid())
  candidateId      Int                                 // FK → Candidate
  offerId          Int                                 // FK → Offer that triggered the flow
  consentVersionId String                                 // FK → ConsentVersion.id
  accepted         Boolean   @default(false)
  acceptedAt       DateTime?
  declinedAt       DateTime?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  candidate      Candidate      @relation(fields: [candidateId], references: [id])
  offer          Offer          @relation(fields: [offerId], references: [id])
  consentVersion ConsentVersion @relation(fields: [consentVersionId], references: [id])

  @@unique([candidateId, offerId, consentVersionId])
  @@map("consent_records")
}

/// Generic security events generated by the OTP/Consent flow.
model SecurityEvent {
  id          String   @id @default(uuid())
  eventType   String                                 // e.g. "OTP_GENERATED", "CONSENT_ACCEPTED"
  candidateId Int?                                   // optional FK → Candidate
  actorId     Int?                                   // optional user (HR) performing an action
  ipAddress   String?
  userAgent   String?
  details     Json?
  createdAt   DateTime @default(now())

  candidate Candidate? @relation(fields: [candidateId], references: [id])

  @@index([candidateId])
  @@map("security_events")
}
